# Required: browser-reachable PocketBase URL, baked into the SvelteKit build.
PUBLIC_PB_URL=http://127.0.0.1:8090

# Optional: request body limit in bytes; must stay above the 30 MiB upload batch limit.
# BODY_SIZE_LIMIT=33554432

# Required in production: public SvelteKit origin; use this or both forwarded-header settings below.
# ORIGIN=https://example.com

# Optional alternative to ORIGIN: proxy header carrying the public protocol; set with HOST_HEADER.
# PROTOCOL_HEADER=x-forwarded-proto

# Optional alternative to ORIGIN: proxy header carrying the public host; set with PROTOCOL_HEADER.
# HOST_HEADER=x-forwarded-host

# Optional but strongly recommended outside local development: seeded superuser password.
# PB_SEED_SUPERUSER_PASSWORD=

# Optional but strongly recommended outside local development: seeded editor password.
# PB_SEED_EDITOR_PASSWORD=

# Optional: 32-character key for encrypting PocketBase settings; set before saving sensitive settings.
# PB_ENCRYPTION=

# Optional: Resend API key for editor invitations and password resets. Mail is off when unset.
# RESEND_API_KEY=

# Public site origin used in emailed set-password links and PocketBase metadata.
# SITE_URL=https://example.com

# Sender display name; when unset, PocketBase keeps its existing sender name.
# MAIL_SENDER_NAME=

# Verified sender address; when unset, PocketBase keeps its existing sender address.
# MAIL_SENDER_ADDRESS=

# Required by promotion scripts and optional for the staging divergence hook: production PocketBase URL. Leaving it unset disables the check, as production deployments should.
# PROMOTE_PROD_URL=

# Required by promotion scripts only: production PocketBase superuser email; never read by the running site.
# PROMOTE_PROD_EMAIL=

# Required by promotion scripts only: production PocketBase superuser password; never read by the running site.
# PROMOTE_PROD_PASSWORD=

# Required by promotion scripts only: staging PocketBase URL; never read by the running site.
# PROMOTE_STAGING_URL=

# Required by promotion scripts only: staging PocketBase superuser email; never read by the running site.
# PROMOTE_STAGING_EMAIL=

# Required by promotion scripts only: staging PocketBase superuser password; never read by the running site.
# PROMOTE_STAGING_PASSWORD=

# Required together for reviews: DataForSEO login. Without both provider credentials, reviews stay dormant and no import can run.
# DATAFORSEO_LOGIN=

# Required together for reviews: DataForSEO password. Without both provider credentials, reviews stay dormant and no import can run.
# DATAFORSEO_PASSWORD=

# Optional: DataForSEO provider host override, defaulting to https://api.dataforseo.com; use a local stand-in to exercise imports.
# DATAFORSEO_BASE_URL=https://api.dataforseo.com

# Optional: secret shared by the PocketBase cron and internal collection endpoint. When unset, the endpoint answers 404 and scheduled collection is off.
# REVIEWS_SCHEDULER_SECRET=

# Required for scheduled reviews: superuser email used by the internal endpoint's own PocketBase client. Server-only; never expose it to the browser.
# PB_SUPERUSER_EMAIL=

# Required for scheduled reviews: matching superuser password for the internal endpoint. Server-only; never expose it to the browser.
# PB_SUPERUSER_PASSWORD=

# Required for scheduled reviews: full collection endpoint URL posted to by the PocketBase cron. Point it at the app directly, not the public proxy; leaving it unset disables scheduled collection.
# REVIEWS_COLLECT_URL=http://127.0.0.1:3000/api/reviews/collect
