{
	"name": "pocketbase-sveltekit-boilerplate",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"pb": "./bin/pocketbase serve --dir=./pb_data --migrationsDir=./pb_migrations",
		"pb:seed": "./bin/pocketbase migrate up --dir=./pb_data --migrationsDir=./pb_migrations"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.2.0",
		"@types/sanitize-html": "^2.16.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@tiptap/core": "^3.30.2",
		"@tiptap/extension-image": "^3.30.2",
		"@tiptap/extension-link": "^3.30.2",
		"@tiptap/extension-underline": "^3.30.2",
		"@tiptap/starter-kit": "^3.30.2",
		"gsap": "^3.15.0",
		"lenis": "^1.3.26",
		"pocketbase": "^0.28.0",
		"sanitize-html": "^2.17.7",
		"sharp": "^0.35.3"
	}
}
